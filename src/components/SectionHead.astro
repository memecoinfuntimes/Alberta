---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  center?: boolean;
  id?: string;
}

const { eyebrow, title, intro, center = false, id } = Astro.props;
---

<div class:list={['section-head', { center }]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id}>{title}</h2>
  {intro && <p class="lede">{intro}</p>}
</div>
