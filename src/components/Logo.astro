---
// Badge logo (Mt. Hood, Portland skyline, trees) beside the business name.
interface Props {
  tone?: 'light' | 'dark';
  as?: 'a' | 'div';
}

const { tone = 'light', as = 'a' } = Astro.props;
const Tag = as;
---

<Tag class:list={['logo', `logo-${tone}`]} {...as === 'a' ? { href: '/', 'aria-label': 'Alberta Construction LLC, home' } : {}}>
  <img class="logo-mark" src="/logo-256.webp" srcset="/logo-256.webp 256w, /logo-512.webp 512w" sizes="120px" width="256" height="256" alt="" />
  <span class="logo-text">
    <span class="logo-name">Alberta<br />Construction</span>
    <span class="logo-sub">LLC · Handyman Services</span>
  </span>
</Tag>
