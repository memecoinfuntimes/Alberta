---
import Icon from './Icon.astro';
import { business } from '../data/site';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Ready to get it done?',
  text = `Call, text, or send a quote request. You'll hear back the same business day.`,
} = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-title">
  <div class="container cta-inner">
    <div>
      <h2 id="cta-title">{title}</h2>
      <p>{text}</p>
    </div>
    <div class="btn-group">
      <a class="btn btn-light" href={business.phoneHref}><Icon name="phone" size={18} /> {business.phone}</a>
      <a class="btn btn-outline" href="/quote/">Get a Free Quote</a>
    </div>
  </div>
</section>
