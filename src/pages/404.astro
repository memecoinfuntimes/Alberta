---
import Base from '../layouts/Base.astro';
import { business } from '../data/site';
---

<Base title="Page Not Found" description="That page doesn't exist.">
  <section class="section">
    <div class="container" style="max-width: 760px; text-align: center">
      <p class="eyebrow" style="justify-content: center">404</p>
      <h1>Page not found</h1>
      <p class="lede">That page doesn’t exist, but I can still help. Call <a href={business.phoneHref}>{business.phone}</a> or head back home.</p>
      <div class="btn-group" style="justify-content: center; margin-top: 32px">
        <a class="btn btn-primary" href="/">Back to Home</a>
      </div>
    </div>
  </section>
</Base>
